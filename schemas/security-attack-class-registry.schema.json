{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://river-review.the3396.com/schemas/security-attack-class-registry.schema.json",
  "title": "Security Attack Class Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "semantics", "evidenceContract", "classes"],
  "properties": {
    "kind": {
      "const": "SecurityAttackClassRegistry"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "coverageUnit", "zeroFindingsRule", "applicabilityRule"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "coverageUnit": { "type": "string", "minLength": 1 },
        "zeroFindingsRule": { "type": "string", "minLength": 1 },
        "applicabilityRule": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "rule"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attackClass" }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "attackClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "question",
        "appliesWhen",
        "skillHints",
        "reviewerHints",
        "investigate",
        "notSufficient"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "appliesWhen": { "$ref": "#/$defs/nonEmptyStringArray" },
        "skillHints": { "$ref": "#/$defs/nonEmptyStringArray" },
        "reviewerHints": { "$ref": "#/$defs/nonEmptyStringArray" },
        "investigate": { "$ref": "#/$defs/nonEmptyStringArray" },
        "notSufficient": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    }
  }
}
