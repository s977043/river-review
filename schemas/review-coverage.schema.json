{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://river-review.the3396.com/schemas/review-coverage.schema.json",
  "title": "River Review Execution Coverage",
  "description": "Contract describing whether planned review execution units completed. Finding count does not determine coverage; runtime emission is wired separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "expectedUnits",
    "completedUnits",
    "requiredUnits",
    "completedRequiredUnits",
    "incompleteRequiredUnitIds",
    "units"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1" },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "not_executed"]
    },
    "expectedUnits": { "type": "integer", "minimum": 0 },
    "completedUnits": { "type": "integer", "minimum": 0 },
    "requiredUnits": { "type": "integer", "minimum": 0 },
    "completedRequiredUnits": { "type": "integer", "minimum": 0 },
    "incompleteRequiredUnitIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewUnit" }
    },
    "fileScope": {
      "description": "Observe-only LLM-facing file-selection ledger. Execution completion remains represented by Review Units. selected records paths present in filesForReview; excluded records raw changed paths removed by configured exclusion or LLM diff optimization. A diff_optimization exclusion may still be inspected by deterministic review logic through raw diff.files.",
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "excluded"],
      "properties": {
        "selected": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "excluded": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileExclusion" },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "reviewUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subjects",
        "reviewerRole",
        "required",
        "status",
        "reasonCode",
        "findingsCount"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["diff-chunk"] },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reviewerRole": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "timed_out"]
        },
        "reasonCode": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "enum": ["reviewer_timeout", "reviewer_error"] }
          ]
        },
        "findingsCount": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "then": { "properties": { "reasonCode": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": { "properties": { "reasonCode": { "const": "reviewer_error" } } }
        },
        {
          "if": {
            "properties": { "status": { "const": "timed_out" } },
            "required": ["status"]
          },
          "then": { "properties": { "reasonCode": { "const": "reviewer_timeout" } } }
        }
      ]
    },
    "fileExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reasonCode"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reasonCode": {
          "type": "string",
          "enum": ["configured_exclusion", "diff_optimization"]
        }
      }
    }
  }
}
