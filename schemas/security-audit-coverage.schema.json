{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://river-review.the3396.com/schemas/security-audit-coverage.schema.json",
  "title": "River Review Security Audit Coverage",
  "description": "Observe-only semantic security-audit coverage. Records which subsystem × trust-boundary × attack-class surfaces were investigated or remain open. It is independent from ReviewCoverage execution completeness, finding lifecycle, and Gate behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "taxonomyVersion",
    "executionPolicy",
    "totalUnits",
    "applicableUnits",
    "coveredUnits",
    "plannedUnits",
    "blockedUnits",
    "deferredUnits",
    "outOfScopeUnits",
    "openUnitIds",
    "units"
  ],
  "properties": {
    "kind": { "const": "SecurityAuditCoverage" },
    "schemaVersion": { "type": "string", "const": "1" },
    "taxonomyVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "executionPolicy": { "const": "source-only" },
    "totalUnits": { "type": "integer", "minimum": 0 },
    "applicableUnits": { "type": "integer", "minimum": 0 },
    "coveredUnits": { "type": "integer", "minimum": 0 },
    "plannedUnits": { "type": "integer", "minimum": 0 },
    "blockedUnits": { "type": "integer", "minimum": 0 },
    "deferredUnits": { "type": "integer", "minimum": 0 },
    "outOfScopeUnits": { "type": "integer", "minimum": 0 },
    "openUnitIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/securityAuditUnit" }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nullableString": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    },
    "sourceEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "lineStart", "lineEnd", "note"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["source", "config", "manifest", "documentation", "history"]
        },
        "path": { "type": "string", "minLength": 1 },
        "lineStart": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        },
        "lineEnd": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        },
        "note": { "$ref": "#/$defs/nullableString" }
      }
    },
    "securityAuditUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subsystem",
        "trustBoundary",
        "attackClassId",
        "state",
        "reasonCode",
        "reviewedPaths",
        "evidenceRefs",
        "relatedFindingIds",
        "validationPlan",
        "explanation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subsystem": { "type": "string", "minLength": 1 },
        "trustBoundary": { "type": "string", "minLength": 1 },
        "attackClassId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "state": {
          "type": "string",
          "enum": ["planned", "covered", "blocked", "deferred", "out_of_scope"]
        },
        "reasonCode": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": [
                "source_evidence_insufficient",
                "unsafe_execution_required",
                "dependency_unavailable",
                "budget_deferred",
                "manual_defer",
                "scope_excluded",
                "not_applicable"
              ]
            }
          ]
        },
        "reviewedPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceEvidenceRef" }
        },
        "relatedFindingIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "validationPlan": { "$ref": "#/$defs/nullableString" },
        "explanation": { "$ref": "#/$defs/nullableString" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "enum": ["planned", "covered"] } },
            "required": ["state"]
          },
          "then": { "properties": { "reasonCode": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "state": { "const": "covered" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "reviewedPaths": { "$ref": "#/$defs/nonEmptyStringArray" },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/sourceEvidenceRef" }
              },
              "validationPlan": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "blocked" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "source_evidence_insufficient",
                  "unsafe_execution_required",
                  "dependency_unavailable"
                ]
              },
              "validationPlan": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "deferred" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "reasonCode": { "enum": ["budget_deferred", "manual_defer"] },
              "validationPlan": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "out_of_scope" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "reasonCode": { "enum": ["scope_excluded", "not_applicable"] },
              "validationPlan": { "type": "null" },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
